 "prepared_report": 0,
 "query": "SELECT\r\n    L.patient AS \"PID:Link/Patient:130\",\r\n    L.patient_name AS \"Name:Data:250\",\r\n    COUNT(L.name) AS \"Lab Results:Int:120\",\r\n    MIN(L.date) AS \"First Date:Date:110\",\r\n    MAX(L.date) AS \"Last Date:Date:110\"\r\nFROM\r\n    `tabLab Result` L\r\nWHERE\r\n    L.date BETWEEN %(from)s AND %(to)s\r\n    AND L.docstatus = 1\r\nGROUP BY\r\n    L.patient, L.patient_name\r\nORDER BY\r\n    L.patient_name",
